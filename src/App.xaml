<Application x:Class="openZPL.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:openZPL"
             xmlns:conv="clr-namespace:openZPL.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <conv:EnumMatchToVisibilityConverter x:Key="EnumMatchToVisibility" />
            <conv:EnumMismatchToVisibilityConverter x:Key="EnumMismatchToVisibility" />
            <conv:EnumToBooleanConverter x:Key="EnumToBoolean" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
            <conv:HAlignToAlignmentConverter x:Key="HAlignToAlignment" />
            <conv:VAlignToAlignmentConverter x:Key="VAlignToAlignment" />
            <conv:BarcodeImageConverter x:Key="BarcodeImage" />
            <conv:Base64ToImageConverter x:Key="Base64ToImage" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
