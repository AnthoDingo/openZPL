<ui:FluentWindow x:Class="openZPL.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:openZPL.Localization"
        xmlns:local="clr-namespace:openZPL"
        xmlns:views="clr-namespace:openZPL.Views"
        mc:Ignorable="d"
        Title="{Binding ViewModel.WindowTitle, ElementName=Editor}"
        Height="900" Width="1200"
        MinHeight="900" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowState="Maximized">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding ViewModel.NewCommand, ElementName=Editor}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding ViewModel.OpenFileCommand, ElementName=Editor}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding ViewModel.SaveCommand, ElementName=Editor}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding ViewModel.SaveAsCommand, ElementName=Editor}" />
        <KeyBinding Key="Q" Modifiers="Control" Command="{Binding ExitCommand, ElementName=RootWindow}" />
    </ui:FluentWindow.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="{Binding ViewModel.WindowTitle, ElementName=Editor}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/openZPL;component/Resources/openZPL.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Menu Grid.Column="0" VerticalAlignment="Center">
                <MenuItem Header="{loc:Loc MenuFile}" Icon="{ui:SymbolIcon Document20}">
                    <MenuItem Header="{loc:Loc MenuNewLabel}" Icon="{ui:SymbolIcon DocumentAdd20}"
                              InputGestureText="Ctrl+N"
                              Command="{Binding ViewModel.NewCommand, ElementName=Editor}" />
                    <MenuItem Header="{loc:Loc MenuOpen}" Icon="{ui:SymbolIcon FolderOpen20}"
                              InputGestureText="Ctrl+O"
                              Command="{Binding ViewModel.OpenFileCommand, ElementName=Editor}" />
                    <Separator />
                    <MenuItem Header="{loc:Loc MenuSave}" Icon="{ui:SymbolIcon Save20}"
                              InputGestureText="Ctrl+S"
                              Command="{Binding ViewModel.SaveCommand, ElementName=Editor}" />
                    <MenuItem Header="{loc:Loc MenuSaveAs}" Icon="{ui:SymbolIcon SaveEdit20}"
                              InputGestureText="{loc:Loc ShortcutSaveAs}"
                              Command="{Binding ViewModel.SaveAsCommand, ElementName=Editor}" />
                    <Separator />
                    <MenuItem Header="{loc:Loc MenuZpl}" Icon="{ui:SymbolIcon Code20}" Command="{Binding ViewModel.ShowZplPreviewCommand, ElementName=Editor}" />
                    <Separator />
                    <MenuItem Header="{loc:Loc MenuExit}" Icon="{ui:SymbolIcon DoorArrowLeft20}"
                              InputGestureText="Ctrl+Q" Click="FileExit_Click" />
                </MenuItem>
                <MenuItem Header="{loc:Loc MenuSettings}" Icon="{ui:SymbolIcon Settings20}">
                    <MenuItem Header="{loc:Loc MenuPrinters}" Icon="{ui:SymbolIcon Print20}"
                              Click="Printers_Click" />
                    <MenuItem Header="{loc:Loc MenuLanguage}" Icon="{ui:SymbolIcon LocalLanguage20}">
                        <MenuItem Header="Francais" IsCheckable="True"
                                  IsChecked="{Binding ViewModel.IsFrench, ElementName=Editor, Mode=OneWay}"
                                  Command="{Binding ViewModel.SetLanguageCommand, ElementName=Editor}"
                                  CommandParameter="fr" />
                        <MenuItem Header="English" IsCheckable="True"
                                  IsChecked="{Binding ViewModel.IsEnglish, ElementName=Editor, Mode=OneWay}"
                                  Command="{Binding ViewModel.SetLanguageCommand, ElementName=Editor}"
                                  CommandParameter="en" />
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="{loc:Loc MenuPrint}" Icon="{ui:SymbolIcon Print20}" InputGestureText="Ctrl+P" Command="{Binding ViewModel.PrintCommand, ElementName=Editor}" />
            </Menu>
        </Grid>

        <views:LabelEditorView x:Name="Editor" Grid.Row="2" />
    </Grid>
</ui:FluentWindow>
