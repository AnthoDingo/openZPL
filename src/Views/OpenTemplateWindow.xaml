<ui:FluentWindow x:Class="openZPL.Views.OpenTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Ouvrir un modele"
        Height="480" Width="420"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Ouvrir un modele" />

        <Grid Grid.Row="1" Margin="20,12,20,0">
            <ListBox x:Name="TemplatesList" BorderThickness="0"
                     MouseDoubleClick="TemplatesList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,6" Padding="10,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                    <Border Background="#2E7D32" CornerRadius="3" Padding="5,1" Margin="8,0,0,0"
                                            Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="ACTIF" FontSize="10" Foreground="White" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock FontSize="11" Opacity="0.6" Margin="0,2,0,0">
                                    <Run Text="{Binding WidthMm, Mode=OneWay, StringFormat={}{0:0.#}}" />
                                    <Run Text="x" />
                                    <Run Text="{Binding HeightMm, Mode=OneWay, StringFormat={}{0:0.#}}" />
                                    <Run Text="mm ·" />
                                    <Run Text="{Binding Dpi}" />
                                    <Run Text="dpi · modifie" />
                                    <Run Text="{Binding UpdatedAt, Mode=OneWay, StringFormat={}{0:dd/MM/yy HH:mm}}" />
                                </TextBlock>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Aucun modele enregistre pour le moment."
                       Opacity="0.6" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Items.Count, ElementName=TemplatesList, Converter={StaticResource CountToVisibility}}" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20">
            <ui:Button Content="Annuler" Click="Cancel_Click" Margin="0,0,8,0" />
            <ui:Button Content="Ouvrir" Appearance="Primary" Icon="{ui:SymbolIcon FolderOpen20}" Click="Open_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
