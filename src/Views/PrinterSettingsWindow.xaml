<ui:FluentWindow x:Class="openZPL.Views.PrinterSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Parametres"
        Height="480" Width="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Parametres" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/openZPL;component/Resources/openZPL.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24,16,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════════════════════════
                 LISTE DES IMPRIMANTES
                 ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Imprimantes" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

                <Border Height="300" BorderBrush="#40808080" BorderThickness="1" CornerRadius="4">
                    <ListBox x:Name="PrintersList" BorderThickness="0" Background="Transparent"
                             SelectionChanged="PrintersList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                        <Border Background="#2E7D32" CornerRadius="3" Padding="4,0" Margin="6,0,0,0"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="defaut" FontSize="9" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding IpPort}" FontSize="11" Opacity="0.6" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <ui:Button Content="Ajouter une imprimante" Icon="{ui:SymbolIcon Add24}"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                           Margin="0,8,0,0" Click="Add_Click" />
            </StackPanel>

            <!-- ══════════════════════════════════════════════════════════
                 DETAIL DE L'IMPRIMANTE SELECTIONNEE
                 ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Column="2" x:Name="DetailPanel" IsEnabled="False"
                        Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self},
                                             Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Nom" Margin="0,0,0,4" />
                <ui:TextBox x:Name="NameTextBox" PlaceholderText="Entrepot 1" Margin="0,0,0,12" />

                <TextBlock Text="Adresse IP" Margin="0,0,0,4" />
                <ui:TextBox x:Name="IpTextBox" PlaceholderText="192.168.1.50" Margin="0,0,0,12" />

                <TextBlock Text="Port" Margin="0,0,0,4" />
                <ui:NumberBox x:Name="PortNumberBox" Minimum="1" Maximum="65535" Margin="0,0,0,16" />

                <ui:ToggleSwitch x:Name="DefaultToggle" Content="Utiliser comme imprimante par defaut" Margin="0,0,0,24" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Supprimer" Appearance="Danger" Margin="0,0,8,0"
                               Icon="{ui:SymbolIcon Delete24}" Click="Delete_Click" />
                    <ui:Button Content="Enregistrer" Appearance="Primary" Click="Save_Click"
                               Icon="{ui:SymbolIcon Save24}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Column="2" Text="Ajoutez une imprimante pour commencer."
                       Opacity="0.6" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsEnabled, ElementName=DetailPanel, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
