<ui:FluentWindow x:Class="openZPL.Views.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:openZPL.Localization"
        Title="{loc:Loc PrintTitle}"
        Height="250" Width="420"
        MinHeight="250" MinWidth="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:Loc PrintTitle}" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/openZPL;component/Resources/openZPL.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" x:Name="FormPanel">
                <TextBlock Text="{loc:Loc PrintPrinter}" Margin="0,0,0,4" />
                <ComboBox x:Name="PrinterComboBox" DisplayMemberPath="DisplayName"
                          HorizontalAlignment="Stretch" Margin="0,0,0,16" />

                <TextBlock Text="{loc:Loc PrintCopies}" Margin="0,0,0,4" />
                <ui:NumberBox x:Name="CopiesNumberBox" Value="1" Minimum="1" Maximum="9999"
                              MinWidth="110" HorizontalAlignment="Left" />
            </StackPanel>

            <TextBlock Grid.Row="0" x:Name="NoPrinterText"
                       Text="{loc:Loc PrintNoPrinter}"
                       Opacity="0.6" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{loc:Loc ButtonCancel}" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
                <ui:Button x:Name="PrintButton" Content="{loc:Loc ButtonPrint}" Appearance="Primary" IsDefault="True"
                           Icon="{ui:SymbolIcon Print24}" Click="Print_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
