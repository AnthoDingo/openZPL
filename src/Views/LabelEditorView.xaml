<UserControl x:Class="openZPL.Views.LabelEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:openZPL.Localization"
             xmlns:models="clr-namespace:openZPL.Models"
             xmlns:vm="clr-namespace:openZPL.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LabelEditorViewModel}"
             d:DesignWidth="1200" d:DesignHeight="700">

    <UserControl.Resources>

        <Style x:Key="ResizeHandleStyle" TargetType="Thumb">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Visibility" Value="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                                BorderThickness="1.5" CornerRadius="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton bascule a icone (barre d'alignement segmentee, facon Word) -->
        <Style x:Key="IconToggleStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaletteButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.3*" MinWidth="220" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="200" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="0.3*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════════
             PANNEAU GAUCHE — palette, calques
             ══════════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <TextBlock Text="{loc:Loc SectionAddElement}" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,0,8" />
                <ui:Button Style="{StaticResource PaletteButtonStyle}"
                           Icon="{ui:SymbolIcon TextT20}" Content="{loc:Loc ElementText}"
                           Command="{Binding AddElementCommand}"
                           CommandParameter="{x:Static models:LabelElementType.Text}" />
                <ui:Button Style="{StaticResource PaletteButtonStyle}"
                           Icon="{ui:SymbolIcon BarcodeScanner20}" Content="{loc:Loc ElementBarcode}"
                           Command="{Binding AddElementCommand}"
                           CommandParameter="{x:Static models:LabelElementType.Barcode}" />
                <ui:Button Style="{StaticResource PaletteButtonStyle}"
                           Icon="{ui:SymbolIcon Image20}" Content="{loc:Loc ElementImage}"
                           Command="{Binding AddElementCommand}"
                           CommandParameter="{x:Static models:LabelElementType.Image}" />

                <Separator Margin="0,12" />

                <TextBlock Text="{loc:Loc SectionLayers}" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,0,8" />
                <ListBox x:Name="LayersList"
                         ItemsSource="{Binding CurrentTemplate.Elements}"
                         SelectedItem="{Binding SelectedElement, Mode=OneWay}"
                         SelectionChanged="LayersList_SelectionChanged"
                         MaxHeight="220">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LabelElement}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Text}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Barcode">
                                                    <Setter Property="Text" Value="{Binding BarcodeValue}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Image">
                                                    <Setter Property="Text" Value="{loc:Loc LayerImage}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </StackPanel>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════════════════════════
             ZONE CENTRALE — toolbar + canvas
             ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc LabelWidth}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Opacity="0.7" />
                    <ui:NumberBox Value="{Binding CurrentTemplate.WidthMm}" MinWidth="90" Margin="0,0,4,0"
                                  Minimum="5" Maximum="600" SpinButtonPlacementMode="Compact" />
                    <TextBlock Text="mm" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12" Opacity="0.6" />

                    <TextBlock Text="{loc:Loc LabelHeight}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Opacity="0.7" />
                    <ui:NumberBox Value="{Binding CurrentTemplate.HeightMm}" MinWidth="90" Margin="0,0,4,0"
                                  Minimum="5" Maximum="600" SpinButtonPlacementMode="Compact" />
                    <TextBlock Text="mm" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12" Opacity="0.6" />

                    <TextBlock Text="DPI" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Opacity="0.7" />
                    <ComboBox ItemsSource="{Binding DpiValues}"
                              SelectedItem="{Binding CurrentTemplate.Dpi}" MinWidth="70" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,0,0">
                        <TextBlock Text="{loc:Loc LabelZoom}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Opacity="0.7" />
                        <Slider Value="{Binding Scale}" Minimum="0.25" Maximum="4" SmallChange="0.05" LargeChange="0.25"
                                Width="140" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="ZoomPercentText" Text="{Binding ZoomPercent, StringFormat={}{0}%}"
                                   VerticalAlignment="Center" FontSize="12" MinWidth="38"
                                   MouseLeftButtonDown="ZoomPercentText_MouseLeftButtonDown" />
                        <ui:TextBox x:Name="ZoomPercentBox" Visibility="Collapsed" ClearButtonEnabled="False"
                                    VerticalAlignment="Center" VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Right"
                                    FontSize="12" Width="38" Height="22" Padding="4,0"
                                    KeyDown="ZoomPercentBox_KeyDown" LostKeyboardFocus="ZoomPercentBox_LostKeyboardFocus" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Border Padding="32" Background="Transparent">
                        <Border x:Name="LabelSurface"
                                Width="{Binding CurrentTemplate.WidthDots}"
                                Height="{Binding CurrentTemplate.HeightDots}"
                                Background="White"
                                BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                                BorderThickness="2"
                                ClipToBounds="True"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                MouseLeftButtonDown="LabelSurface_MouseLeftButtonDown"
                                PreviewKeyDown="LabelSurface_PreviewKeyDown"
                                Focusable="True">
                            <Border.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                            </Border.LayoutTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.3" />
                            </Border.Effect>

                            <ItemsControl ItemsSource="{Binding CurrentTemplate.Elements}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Background="Transparent" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:LabelElement}">
                                        <Grid Width="{Binding Width}" Height="{Binding Height}">

                                            <!-- Cadre non-selectionne (pointille) -->
                                            <Rectangle Stroke="#ADB5BD" StrokeThickness="1" StrokeDashArray="4 2" Fill="Transparent"
                                                       Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                                            <!-- Cadre selectionne -->
                                            <Border BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}" BorderThickness="2"
                                                    Background="#160D6EFD"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />

                                            <!-- Contenu -->
                                            <Grid IsHitTestVisible="False" Margin="2" ClipToBounds="True">

                                                <!-- Texte -->
                                                <TextBlock Text="{Binding Text}"
                                                           FontSize="{Binding FontSize}"
                                                           Foreground="Black"
                                                           TextWrapping="NoWrap"
                                                           Visibility="{Binding Type, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=Text}"
                                                           HorizontalAlignment="{Binding HAlign, Converter={StaticResource HAlignToAlignment}}"
                                                           VerticalAlignment="{Binding VAlign, Converter={StaticResource VAlignToAlignment}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Bold}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Italic}" Value="True">
                                                                    <Setter Property="FontStyle" Value="Italic" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Code-barres -->
                                                <Grid Visibility="{Binding Type, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=Barcode}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0">
                                                        <!-- Code128 : barres etirees sur toute la cellule -->
                                                        <Image Stretch="Fill"
                                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                               Visibility="{Binding BarcodeType, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=Code128}">
                                                            <Image.Source>
                                                                <MultiBinding Converter="{StaticResource BarcodeImage}">
                                                                    <Binding Path="BarcodeValue" />
                                                                    <Binding Path="BarcodeType" />
                                                                    <Binding Path="Width" />
                                                                    <Binding Path="Height" />
                                                                </MultiBinding>
                                                            </Image.Source>
                                                        </Image>
                                                        <!-- QRCode / DataMatrix : carre, aligne a gauche -->
                                                        <Image HorizontalAlignment="Left" Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                               Visibility="{Binding BarcodeType, Converter={StaticResource EnumMismatchToVisibility}, ConverterParameter=Code128}">
                                                            <Image.Source>
                                                                <MultiBinding Converter="{StaticResource BarcodeImage}" ConverterParameter="Square">
                                                                    <Binding Path="BarcodeValue" />
                                                                    <Binding Path="BarcodeType" />
                                                                    <Binding Path="Width" />
                                                                    <Binding Path="Height" />
                                                                </MultiBinding>
                                                            </Image.Source>
                                                        </Image>
                                                    </Grid>

                                                    <!-- Reserve automatiquement sa hauteur (Auto) quand visible, sinon 0 -->
                                                    <TextBlock Grid.Row="1" Text="{Binding BarcodeValue}" FontSize="11" Margin="0,2,0,0"
                                                               Foreground="Black"
                                                               HorizontalAlignment="{Binding HAlign, Converter={StaticResource HAlignToAlignment}}"
                                                               Visibility="{Binding ShowHri, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>

                                                <!-- Image -->
                                                <Grid Visibility="{Binding Type, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=Image}">
                                                    <Border Background="#E9ECEF"
                                                            Visibility="{Binding ImageData, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">
                                                        <TextBlock Text="{loc:Loc ElementImage}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   FontSize="11" Foreground="Black" Opacity="0.6" />
                                                    </Border>
                                                    <Image Source="{Binding ImageData, Converter={StaticResource Base64ToImage}}" Stretch="Uniform"
                                                           Visibility="{Binding ImageData, Converter={StaticResource NullToVisibility}}" />
                                                </Grid>
                                            </Grid>

                                            <!-- Deplacement -->
                                            <Thumb Background="Transparent" Cursor="SizeAll"
                                                   DragStarted="MoveThumb_DragStarted"
                                                   DragDelta="MoveThumb_DragDelta">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Rectangle Fill="{TemplateBinding Background}" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>

                                            <!-- Poignees de redimensionnement -->
                                            <Thumb Style="{StaticResource ResizeHandleStyle}" Tag="nw" Cursor="SizeNWSE"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-5,-5,0,0"
                                                   DragDelta="ResizeThumb_DragDelta" />
                                            <Thumb Style="{StaticResource ResizeHandleStyle}" Tag="n" Cursor="SizeNS"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-5,0,0"
                                                   DragDelta="ResizeThumb_DragDelta" />
                                            <Thumb Style="{StaticResource ResizeHandleStyle}" Tag="ne" Cursor="SizeNESW"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0"
                                                   DragDelta="ResizeThumb_DragDelta" />
                                            <Thumb Style="{StaticResource ResizeHandleStyle}" Tag="e" Cursor="SizeWE"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-5,0"
                                                   DragDelta="ResizeThumb_DragDelta" />
                                            <Thumb Style="{StaticResource ResizeHandleStyle}" Tag="se" Cursor="SizeNWSE"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5"
                                                   DragDelta="ResizeThumb_DragDelta" />
                                            <Thumb Style="{StaticResource ResizeHandleStyle}" Tag="s" Cursor="SizeNS"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-5"
                                                   DragDelta="ResizeThumb_DragDelta" />
                                            <Thumb Style="{StaticResource ResizeHandleStyle}" Tag="sw" Cursor="SizeNESW"
                                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-5,0,0,-5"
                                                   DragDelta="ResizeThumb_DragDelta" />
                                            <Thumb Style="{StaticResource ResizeHandleStyle}" Tag="w" Cursor="SizeWE"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-5,0,0,0"
                                                   DragDelta="ResizeThumb_DragDelta" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Border>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             PANNEAU DROIT — proprietes de l'element selectionne
             ══════════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      DataContext="{Binding SelectedElement}">
            <StackPanel Visibility="{Binding Converter={StaticResource NullToVisibility}}">

                <Grid Margin="0,0,0,10">
                    <TextBlock Text="{loc:Loc PropertiesTitle}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Icon="{ui:SymbolIcon ArrowUp20}" Padding="5" Margin="0,0,4,0" ToolTip="{loc:Loc TipMoveUp}"
                                   Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <ui:Button Icon="{ui:SymbolIcon ArrowDown20}" Padding="5" Margin="0,0,4,0" ToolTip="{loc:Loc TipMoveDown}"
                                   Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <ui:Button Icon="{ui:SymbolIcon Delete20}" Padding="5" Appearance="Danger" ToolTip="{loc:Loc TipDelete}"
                                   Command="{Binding DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{loc:Loc SectionPositionSize}" FontSize="10" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="6" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="X" FontSize="11" Opacity="0.6" />
                        <ui:NumberBox Value="{Binding X}" Minimum="0" SpinButtonPlacementMode="Hidden" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Y" FontSize="11" Opacity="0.6" />
                        <ui:NumberBox Value="{Binding Y}" Minimum="0" SpinButtonPlacementMode="Hidden" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="{loc:Loc LabelWidth}" FontSize="11" Opacity="0.6" />
                        <ui:NumberBox Value="{Binding Width}" Minimum="10" SpinButtonPlacementMode="Hidden" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="{loc:Loc LabelHeight}" FontSize="11" Opacity="0.6" />
                        <ui:NumberBox Value="{Binding Height}" Minimum="10" SpinButtonPlacementMode="Hidden" />
                    </StackPanel>
                </Grid>

                <!-- Alignement (Texte uniquement — sans effet pour Code-barres/Image) -->
                <StackPanel Visibility="{Binding Type, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=Text}">
                    <TextBlock Text="{loc:Loc SectionHAlign}" FontSize="10" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,0,6" />
                    <WrapPanel Margin="0,0,0,10">
                        <RadioButton Style="{StaticResource IconToggleStyle}" GroupName="HAlign" ToolTip="{loc:Loc TipAlignLeft}"
                                     IsChecked="{Binding HAlign, Converter={StaticResource EnumToBoolean}, ConverterParameter=Left}">
                            <ui:SymbolIcon Symbol="TextAlignLeft20" FontSize="16" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource IconToggleStyle}" GroupName="HAlign" ToolTip="{loc:Loc TipAlignCenter}"
                                     IsChecked="{Binding HAlign, Converter={StaticResource EnumToBoolean}, ConverterParameter=Center}">
                            <ui:SymbolIcon Symbol="TextAlignCenter20" FontSize="16" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource IconToggleStyle}" GroupName="HAlign" ToolTip="{loc:Loc TipAlignRight}" Margin="0"
                                     IsChecked="{Binding HAlign, Converter={StaticResource EnumToBoolean}, ConverterParameter=Right}">
                            <ui:SymbolIcon Symbol="TextAlignRight20" FontSize="16" />
                        </RadioButton>
                    </WrapPanel>

                    <TextBlock Text="{loc:Loc SectionVAlign}" FontSize="10" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,0,6" />
                    <WrapPanel Margin="0,0,0,12">
                        <RadioButton Style="{StaticResource IconToggleStyle}" GroupName="VAlign" ToolTip="{loc:Loc TipAlignTop}"
                                     IsChecked="{Binding VAlign, Converter={StaticResource EnumToBoolean}, ConverterParameter=Top}">
                            <ui:SymbolIcon Symbol="AlignTop20" FontSize="16" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource IconToggleStyle}" GroupName="VAlign" ToolTip="{loc:Loc TipAlignMiddle}"
                                     IsChecked="{Binding VAlign, Converter={StaticResource EnumToBoolean}, ConverterParameter=Middle}">
                            <ui:SymbolIcon Symbol="AlignCenterVertical20" FontSize="16" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource IconToggleStyle}" GroupName="VAlign" ToolTip="{loc:Loc TipAlignBottom}" Margin="0"
                                     IsChecked="{Binding VAlign, Converter={StaticResource EnumToBoolean}, ConverterParameter=Bottom}">
                            <ui:SymbolIcon Symbol="AlignBottom20" FontSize="16" />
                        </RadioButton>
                    </WrapPanel>
                </StackPanel>

                <!-- Texte -->
                <StackPanel Visibility="{Binding Type, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=Text}">
                    <TextBlock Text="{loc:Loc SectionContent}" FontSize="10" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,0,6" />
                    <ui:TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True" Height="50" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{loc:Loc LabelFontSize}" FontSize="11" Opacity="0.6" />
                        <ui:NumberBox Value="{Binding FontSize}" MinWidth="90" HorizontalAlignment="Left"
                                      Minimum="8" Maximum="300" SpinButtonPlacementMode="Hidden" Margin="0,0,0,8" />
                        <WrapPanel>
                            <CheckBox Content="{loc:Loc LabelBold}" FontWeight="Bold" IsChecked="{Binding Bold}" Margin="0,0,16,0" />
                            <CheckBox Content="{loc:Loc LabelItalic}" FontStyle="Italic" IsChecked="{Binding Italic}" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Code-barres -->
                <StackPanel Visibility="{Binding Type, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=Barcode}">
                    <TextBlock Text="{loc:Loc SectionValue}" FontSize="10" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,0,6" />
                    <ui:TextBox Text="{Binding BarcodeValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                    <TextBlock Text="{loc:Loc SectionType}" FontSize="10" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding DataContext.BarcodeTypeValues, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding BarcodeType}" Margin="0,0,0,10" />

                    <CheckBox Content="{loc:Loc LabelShowHri}" IsChecked="{Binding ShowHri}" Margin="0,0,0,10" />

                    <StackPanel Visibility="{Binding ShowHri, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{loc:Loc SectionValueAlign}" FontSize="10" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,0,6" />
                        <WrapPanel>
                            <RadioButton Style="{StaticResource IconToggleStyle}" GroupName="BarcodeHAlign" ToolTip="{loc:Loc TipAlignLeft}"
                                         IsChecked="{Binding HAlign, Converter={StaticResource EnumToBoolean}, ConverterParameter=Left}">
                                <ui:SymbolIcon Symbol="TextAlignLeft20" FontSize="16" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource IconToggleStyle}" GroupName="BarcodeHAlign" ToolTip="{loc:Loc TipAlignCenter}"
                                         IsChecked="{Binding HAlign, Converter={StaticResource EnumToBoolean}, ConverterParameter=Center}">
                                <ui:SymbolIcon Symbol="TextAlignCenter20" FontSize="16" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource IconToggleStyle}" GroupName="BarcodeHAlign" ToolTip="{loc:Loc TipAlignRight}" Margin="0"
                                         IsChecked="{Binding HAlign, Converter={StaticResource EnumToBoolean}, ConverterParameter=Right}">
                                <ui:SymbolIcon Symbol="TextAlignRight20" FontSize="16" />
                            </RadioButton>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Image -->
                <StackPanel Visibility="{Binding Type, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=Image}">
                    <TextBlock Text="{loc:Loc SectionImageFile}" FontSize="10" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,0,6" />
                    <ui:Button Content="{loc:Loc ButtonChooseImage}" Icon="{ui:SymbolIcon Image20}" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left" Margin="0,0,0,8"
                               Command="{Binding DataContext.UploadImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="4" Padding="4"
                            Visibility="{Binding ImageData, Converter={StaticResource NullToVisibility}}">
                        <Image Source="{Binding ImageData, Converter={StaticResource Base64ToImage}}" Stretch="Uniform" MaxHeight="140" />
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
